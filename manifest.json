{
  "manifest_version": 3,
  "name": "LinkedIn Theme Toggle",
  "version": "1.0.0",
  "description": "Toggle LinkedIn theme with a single click by updating the li_theme cookie.",
  "permissions": ["cookies"],
  "host_permissions": ["https://*.linkedin.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle LinkedIn theme",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
